CompileFlags:
  CompilationDatabase: "build"
  # clangd bug work around: https://github.com/clangd/clangd/issues/1850#issuecomment-1841985906
  Add: [
      #
      "-Wall",
      "-Wextra",
      "-Wno-c++98-compat",
      "-Wunused",
      "-std:latest",
      "/clang:-std=c++23",
    ]

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add: [
        #
        bugprone-*,
        cert-*,
        modernize-*,
        performance-*,

        misc-*,
        clang-diagnostic-*,
        clang-analyzer-*,
        cppcoreguidelines-*,
      ]
    Remove: [
        #
        bugprone-easily-swappable-parameters,
        cppcoreguidelines-avoid-c-arrays,
        cppcoreguidelines-avoid-magic-numbers,
        cppcoreguidelines-avoid-non-const-global-variables,
        cppcoreguidelines-narrowing-conversions, # duplicated bugprone lint
        cppcoreguidelines-owning-memory, # In Skyrim, there are times when a memory leak is necessary.
        cppcoreguidelines-pro-type-reinterpret-cast,
        cppcoreguidelines-pro-type-vararg,
        misc-non-private-member-variables-in-classes,
        modernize-use-trailing-return-type,
        performance-enum-size,
      ]
